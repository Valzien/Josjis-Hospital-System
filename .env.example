APP_NAME="JOSJIS Hospital System"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# --- Database ---
# MySQL 8 (produksi / Docker)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=josjis_hospital
DB_USERNAME=josjis
DB_PASSWORD=

# SQLite (opsional, untuk pengembangan lokal tanpa MySQL)
# DB_CONNECTION=sqlite
# DB_DATABASE=database/database.sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@josjis-hospital.test"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# --- Identitas aplikasi (config/jhs.php) ---
JHS_NAME="JOSJIS Hospital System"
JHS_SHORT_NAME=JHS
JHS_TAGLINE="Hospital Information System"
JHS_DESCRIPTION="Sistem informasi rumah sakit terpadu untuk layanan pasien yang cepat, akurat, dan dapat diaudit."
JHS_ADDRESS="Jl. Prototype No. 00, Kota Simulasi"
JHS_PHONE="(021) 000-0000"
JHS_EMAIL="info@josjis-hospital.test"
JHS_HOURS="Senin - Sabtu, 08.00 - 20.00 WIB (IGDuty 24 jam)"

# --- Aturan operasional ---
# Prefix nomor antrean harian per dokter.
JHS_QUEUE_PREFIX=A
# Estimasi menit per pasien untuk estimasi waktu antrean.
JHS_ESTIMATED_MINUTES=10
# Interval auto-refresh papan antrean (detik). 0 = nonaktif.
JHS_AUTO_CALL_REFRESH=30
# Tampilkan blok akun demo pada halaman login. WAJIB false di produksi.
JHS_DEMO_CREDENTIALS=true
